# Bu dosyayı kopyalayıp adını ".env" yapın ve değerleri doldurun.
# .env dosyası GitHub'a gönderilmez.
# MakerWorld için anahtar gerekmez; buradaki her şey isteğe bağlıdır.

# Supabase (boş bırakılırsa veriler data/urunler.db dosyasına yazılır)
# Supabase panel > Project Settings > API Keys
SUPABASE_URL=
# "secret" (sb_secret_...) anahtarı — yalnızca bu bilgisayarda ve GitHub Secrets'ta durur
SUPABASE_KEY=
# Panel için tarayıcı anahtarı (sb_publishable_...); panel/ayar.js'e de yazılır
SUPABASE_PUBLISHABLE_KEY=

# Telegram bildirimi (isteğe bağlı) — README "Telegram bildirimi"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
