# Bu dosyayı kopyalayıp adını ".env" yapın ve değerleri doldurun.
# .env dosyası GitHub'a gönderilmez.
# MakerWorld için anahtar gerekmez; buradaki her şey isteğe bağlıdır.

# Supabase (boş bırakılırsa veriler data/urunler.db dosyasına yazılır)
# Supabase panel > Project Settings > API Keys
SUPABASE_URL=
# "secret" (sb_secret_...) anahtarı — yalnızca bu bilgisayarda ve GitHub Secrets'ta durur
SUPABASE_KEY=
# Panel için tarayıcı anahtarı (sb_publishable_...); panel/ayar.js'e de yazılır
SUPABASE_PUBLISHABLE_KEY=

# Telegram bildirimi (isteğe bağlı) — README "Telegram bildirimi"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-ticaret araştırması (isteğe bağlı) — https://serpapi.com ücretsiz plan
SERPAPI_KEY=
# İlan fotoğraflarını MakerWorld görseliyle karşılaştırma (isteğe bağlı) — README 6b. adım, platform.claude.com
ANTHROPIC_API_KEY=

# Instagram paylaşımı (isteğe bağlı) — README 6c. adım (Meta geliştirici uygulamasından token)
INSTAGRAM_TOKEN=
# Token EAA… ile başlıyorsa (Unified login) Instagram hesap kimliği (Meta panelinde hesabın altındaki sayı)
INSTAGRAM_HESAP_ID=
# Yerelde video düzenlemeyi denemek için ffmpeg PATH'te değilse tam yolu (isteğe bağlı)
FFMPEG_YOLU=

# Yazıcı köprüsü (python -m urun_bulucu.kopru; yalnızca evdeki bilgisayarda, GitHub Secrets'a EKLEMEYİN)
# Yazıcı ekranı: Ayarlar → WLAN (IP ve "Access Code"), Ayarlar → Cihaz (seri numarası)
YAZICI_IP=
YAZICI_ERISIM_KODU=
YAZICI_SERI=
# Panelde siparişe yazılan yazıcı adı (varsayılan "Bambu P1S")
YAZICI_ADI=
# Güvenlik: "python -m urun_bulucu.kopru --dene" çıktısındaki sertifika parmak izi
YAZICI_PARMAK_IZI=
