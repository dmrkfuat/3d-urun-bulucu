# Bu dosyayı kopyalayıp adını ".env" yapın ve değerleri doldurun.
# .env dosyası GitHub'a gönderilmez.

# Thingiverse uygulama anahtarı (App Token)
# Alma adımları README.md içinde: "Thingiverse anahtarı"
THINGIVERSE_TOKEN=

# Supabase (boş bırakılırsa veriler data/urunler.db dosyasına yazılır)
# Supabase panel > Project Settings > API
SUPABASE_URL=
# "secret" / "service_role" anahtarı — yalnızca bu bilgisayarda ve GitHub Secrets'ta durur
SUPABASE_KEY=
